# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，勿提交）

# 容器时区（影响日志与状态展示时间，内部一律用 UTC）
TZ=Asia/Shanghai

# 容器以哪个 uid/gid 运行。
# Linux 上必须与宿主一致，否则挂载目录不可写、token 回写会失败：
#   echo "UID=$(id -u)" >> .env
#   echo "GID=$(id -g)" >> .env
UID=1000
GID=1000

# ---------------------------------------------------------------------------------------
# 运行根目录：config/ state/ logs/ plugins/ 的父目录（容器内固定用 /app）
# ---------------------------------------------------------------------------------------
JWT_ALIVE_DATA_DIR=/app

# ---------------------------------------------------------------------------------------
# 对外 API 的 token 表：API_ID 是标识（不参与校验），API_TOKEN 是允许的 token 值
# 请求时把 API_TOKEN 放在请求头：Authorization: Bearer <token>（或 X-Token / X-API-Key）
# ---------------------------------------------------------------------------------------
API_ID=default
API_TOKEN=

# ---------------------------------------------------------------------------------------
# 各站点的 token：config/sites.yaml 里用 ${变量名} 引用
# ---------------------------------------------------------------------------------------
EXAMPLE_ACCESS_TOKEN=
EXAMPLE_REFRESH_TOKEN=
OTHER_ACCESS_TOKEN=
OTHER_REFRESH_TOKEN=
